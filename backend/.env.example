NODE_ENV=development
PORT=4000
MONGODB_DB=BloodBridge
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006

# Required to read the protected admin dashboard endpoint. Use the same
# server-only value in admin/.env.local and generate at least 32 random bytes.
ADMIN_DASHBOARD_TOKEN=

# Confirm these matching-policy values with the applicable blood service before production.
DONATION_MIN_INTERVAL_DAYS=112
MATCHING_AVERAGE_TRAVEL_SPEED_KMH=25
MATCHING_TIME_ZONE=Africa/Douala

# Optional when Expo Push Service enhanced security is enabled.
EXPO_PUSH_ACCESS_TOKEN=

# Optional Gmail SMTP email delivery for hospital notifications.
# Add these values only in backend/.env using your real Gmail credentials or app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional Meta WhatsApp Cloud API donor match notifications.
# Create an approved template with seven body parameters in this order:
# donor name, hospital, urgency, blood type, city, match rank, request details
# (needed-by date, followed by the reward amount when one is offered).
WHATSAPP_ACCESS_TOKEN=EAAUSPVnSg1MBSivJXuskZCjUPHQydE7s7IgDZCZBikMQqozUTDsky7hVuTCZBGONXZCiF94YWWJIidUblkVrzEU4j2cqvTHN56TpReTpZAA6KzMiepAKH5GkWsDuMJ0ZAUCmyzH3uiIYfnaDlAZC8vOygE7enoPjK7KJ3rcc5pEBhZC42hyfOYvAzecFlrezyUFZCz60qZAOZAWgdsXiIKiZBPr2H2IgxiAdBz6vToMHds5sHXuFsIq8EVZBRnYbDy6DTFovfdnZCaYAdJelxIUCyKQtf1Ucyli
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BLOOD_REQUEST_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v23.0

# Optional AI assistant and donor eligibility screening. Keep the API key only in backend/.env.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_REQUEST_DRAFT_MODEL=gpt-5.4-mini
