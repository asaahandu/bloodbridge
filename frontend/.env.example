# Public Expo configuration. Never place database credentials in this file.
# Use the backend computer's LAN IP for Expo Go on a physical phone.
# localhost works only when the app and backend run on the same host.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public EAS project ID used when obtaining an Expo push token.
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
